# Copy this file to `.env` and fill in your Supabase credentials
# The EXPO_PUBLIC_ prefix exposes these to the client at runtime (safe for anon key)

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional: AI keys if you plan to use external providers later (not required now)
# EXPO_PUBLIC_OPENAI_API_KEY=
# EXPO_PUBLIC_AI_API_ENDPOINT=
